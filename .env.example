# =============================================================================
# BRATS — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# Neon:    https://neon.tech  — free tier, serverless Postgres
# Supabase: https://supabase.com — free tier, full Postgres
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@host:5432/brats?sslmode=require"

# For Neon: use the pooled connection for DATABASE_URL and the direct connection
# for DIRECT_URL (required for Prisma migrations).
DIRECT_URL="postgresql://user:password@host:5432/brats?sslmode=require"

# -----------------------------------------------------------------------------
# NextAuth.js
# Generate a secret: openssl rand -base64 32
# -----------------------------------------------------------------------------
NEXTAUTH_SECRET="your-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# OAuth — GitHub (optional, for GitHub login)
# Create at: https://github.com/settings/developers
# -----------------------------------------------------------------------------
GITHUB_ID="your-github-oauth-app-id"
GITHUB_SECRET="your-github-oauth-app-secret"

# -----------------------------------------------------------------------------
# Email (for magic link auth)
# Resend: https://resend.com — free tier, 100 emails/day
# -----------------------------------------------------------------------------
EMAIL_SERVER="smtp://username:password@smtp.resend.com:587"
EMAIL_FROM="BRATS <noreply@yourdomain.com>"

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
